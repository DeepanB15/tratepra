# --- Environment ---
# development | production. In production the app refuses to start if INTERNAL_API_TOKEN is
# "change-me" or shorter than 16 characters, or if CORS_ORIGINS contains a wildcard.
# In production also set AUTO_CREATE_TABLES=false and manage the schema with `alembic upgrade head`.
APP_ENV=development
AUTO_CREATE_TABLES=true

# --- Database ---
# Supabase (recommended): Dashboard -> Project -> Connect -> Connection string (session pooler).
# URL-encode special characters in the password. postgres://, postgresql:// and
# postgresql+asyncpg:// forms are all accepted; the app normalises them and adds sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres
# Local alternative (see docker-compose.local-db.yml):
# DATABASE_URL=postgresql+psycopg2://tratepra:tratepra@localhost:5432/tratepra
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Ollama / LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Connectors (credentials are backend-only)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tratepra/1.0
GOOGLE_TRENDS_API_KEY=
# Endpoint provided with your alpha access (Google publishes none). Key + endpoint are both required.
GOOGLE_TRENDS_API_ENDPOINT=
# Experimental, unofficial fallback (pytrends). Off by default.
GOOGLE_TRENDS_ALLOW_FALLBACK=false

# Internal endpoints protection (send as X-Internal-Token)
# generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=change-me

# CORS
CORS_ORIGINS=http://localhost:5173
